<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bruges</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f8f6f2;
      color: #333;
      line-height: 1.6;
    }

    .container {
      width: min(1000px, calc(100% - 40px));
      margin: auto;
    }

    nav {
      height: 75px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .back {
      color: #333;
      text-decoration: none;
      font-size: 14px;
    }

    .language {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .language button {
      border: none;
      background: transparent;
      color: #999;
      cursor: pointer;
      font-size: 13px;
      padding: 5px;
    }

    .language button.active {
      color: #333;
      font-weight: 700;
    }

    .hero {
      text-align: center;
      padding: 65px 20px 55px;
    }

    .eyebrow {
      color: #8a7055;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-family: Georgia, serif;
      font-size: clamp(52px, 9vw, 82px);
      font-weight: 500;
      letter-spacing: -3px;
      line-height: 1;
    }

    .section {
      margin-bottom: 50px;
    }

    .section-label {
      color: #8a7055;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .section-title {
      font-family: Georgia, serif;
      font-size: 34px;
      font-weight: 500;
      margin-bottom: 25px;
    }

    /* HOTEL */

    .hotel-card {
      background: white;
      border: 1px solid #e5dfd7;
      border-radius: 18px;
      padding: 25px;
    }

    .hotel-name {
      font-family: Georgia, serif;
      font-size: 27px;
      margin-bottom: 12px;
    }

    .hotel-address {
      display: inline-block;
      color: #8a7055;
      text-decoration: none;
      font-size: 14px;
      border-bottom: 1px solid #cdbda9;
      padding-bottom: 2px;
    }

    .hotel-address:hover {
      color: #333;
      border-color: #333;
    }

    .hotel-note {
      color: #888;
      font-size: 13px;
      margin-top: 15px;
    }

    /* ITINERARY */

    .day {
      background: white;
      border: 1px solid #e5dfd7;
      border-radius: 18px;
      padding: 25px;
      margin-bottom: 15px;
    }

    .day-date {
      color: #8a7055;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .day-title {
      font-family: Georgia, serif;
      font-size: 24px;
      margin-bottom: 12px;
    }

    .activity {
      border-top: 1px solid #eee;
      padding: 15px 0;
    }

    .activity:first-of-type {
      border-top: none;
    }

    .activity-time {
      color: #8a7055;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .activity-name {
      font-family: Georgia, serif;
      font-size: 20px;
      margin-bottom: 6px;
    }

    .activity-note {
      color: #777;
      font-size: 13px;
      margin: 6px 0;
    }

    footer {
      border-top: 1px solid #e3ded7;
      color: #999;
      font-size: 13px;
      padding: 30px;
      text-align: center;
      margin-top: 30px;
    }

    @media (max-width: 650px) {
      .hero {
        padding-top: 45px;
      }

      .hero h1 {
        letter-spacing: -2px;
      }
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->

  <nav class="container">

    <a href="index.html" class="back" id="backButton">
      ← Back to trip
    </a>

    <div class="language">

      <button
        id="englishButton"
        class="active"
        onclick="setLanguage('en')">
        🇺🇸 English
      </button>

      <span>|</span>

      <button
        id="spanishButton"
        onclick="setLanguage('es')">
        🇲🇽 Español
      </button>

    </div>

  </nav>


  <!-- BRUGES -->

  <section class="hero container">

    <div class="eyebrow">
      October 25 – 26, 2026
    </div>

    <h1 id="mainTitle">
      Bruges
    </h1>

  </section>


  <!-- HOTEL -->

  <section class="section container">

    <div class="section-label" id="hotelLabel">
      Where We're Staying
    </div>

    <div class="section-title" id="hotelTitle">
      Our Hotel
    </div>

    <div class="hotel-card">

      <div class="hotel-name">
        Martin's Relais
      </div>

      <a
        class="hotel-address"
        href="https://maps.apple.com/?address=Genthof%204A%2C%208000%20Bruges%2C%20Belgium"
        target="_blank"
        rel="noopener noreferrer">

        Genthof 4a
        8000 Bruges
        Belgium

      </a>

      <div class="hotel-note" id="hotelNote">
        Tap the address to open it in Apple Maps.
      </div>

    </div>

  </section>


  <!-- ITINERARY -->

  <section class="section container">

    <div class="section-label" id="itineraryLabel">
      Itinerary
    </div>

    <div class="section-title" id="itineraryTitle">
      Bruges
    </div>


    <!-- OCTOBER 25 -->

    <div class="day">

      <div class="day-date">
        Sunday · October 25
      </div>

      <div class="day-title">
        Arrival in Bruges
      </div>

    </div>


    <!-- OCTOBER 26 -->

    <div class="day">

      <div class="day-date">
        Monday · October 26
      </div>

      <div class="day-title">
        Bruges → Florence
      </div>

    </div>

  </section>


  <footer>
    Europe Trip · Bruges · 2026
  </footer>


  <script>

    function setLanguage(language) {

      const englishButton =
        document.getElementById("englishButton");

      const spanishButton =
        document.getElementById("spanishButton");

      if (language === "es") {

        document.documentElement.lang = "es";

        document.getElementById("backButton").textContent =
          "← Volver al viaje";

        document.getElementById("mainTitle").textContent =
          "Brujas";

        document.getElementById("hotelLabel").textContent =
          "Dónde nos hospedamos";

        document.getElementById("hotelTitle").textContent =
          "Nuestro hotel";

        document.getElementById("hotelNote").textContent =
          "Toca la dirección para abrirla en Apple Maps.";

        document.getElementById("itineraryLabel").textContent =
          "Itinerario";

        document.getElementById("itineraryTitle").textContent =
          "Brujas";

        englishButton.classList.remove("active");
        spanishButton.classList.add("active");

      } else {

        document.documentElement.lang = "en";

        document.getElementById("backButton").textContent =
          "← Back to trip";

        document.getElementById("mainTitle").textContent =
          "Bruges";

        document.getElementById("hotelLabel").textContent =
          "Where We're Staying";

        document.getElementById("hotelTitle").textContent =
          "Our Hotel";

        document.getElementById("hotelNote").textContent =
          "Tap the address to open it in Apple Maps.";

        document.getElementById("itineraryLabel").textContent =
          "Itinerary";

        document.getElementById("itineraryTitle").textContent =
          "Bruges";

        englishButton.classList.add("active");
        spanishButton.classList.remove("active");

      }

    }

  </script>

</body>
</html>
